{
  "name": "pretty-panels-electron-example",
  "private": true,
  "version": "0.0.0",
  "description": "A frameless Electron window whose chrome is drawn by pretty-panels.",
  "main": "main.cjs",
  "scripts": {
    "start": "vite build && electron .",
    "dev": "vite",
    "dev:electron": "ELECTRON_RENDERER_URL=http://localhost:5173 electron .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pretty-panels": "file:../..",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^44.4.4",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
